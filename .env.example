# Copy to .env and fill in. Every value below has a working default except the
# SendGrid pair, so the app runs with no .env at all for local development.

# Secret used to sign JWTs. The fallback in server/config/config.js is fine for
# local work and deliberately obviously-insecure so it can't reach production.
JWT_SECRET=change-me

# Defaults to mongodb://localhost/realestatedb.
MONGODB_URI=mongodb://localhost/realestatedb

# Port the API listens on. Defaults to 5001.
PORT=5001

# Origin allowed by CORS. Defaults to http://localhost:3000, which is where the
# CRA dev server runs. Change it if you start the client on a different port.
CLIENT_ORIGIN=http://localhost:3000

# Only needed for POST /api/email/github-pages. Without them that route returns
# 400 with an explanatory message rather than failing at startup.
SENDGRID_API_KEY=
SENDGRID_TEMPLATE_ID=
